    for delay_ms in delays_ms:
        print(f"\n--- Testing {delay_ms}ms inter-UBT delay ---")
        
        # Send first UBT
        result1 = test_single_ubt(ga, lane_mask, delay_after_ms=delay_ms, monitor_ms=200)
        if not result1["success"]:
