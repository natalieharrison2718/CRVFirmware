def wait_for_autotx_idle(ga: int, timeout_s: float = 1.0) -> bool:
    """
    Wait until PhyTxBuff is empty and TxEnAck is deasserted,
    indicating any previous AutoTx transmission has fully completed.
    """
    a_csr = compose_a16(ga, RegAddr.PhyTxCSRAddr)
    t_deadline = time.time() + timeout_s
    while time.time() < t_deadline:
        ok, csr = safe_read(a_csr, "PhyTxCSR")
        if ok:
            tx_ack   = (csr & 0x0001) != 0
            tx_empty = (csr & 0x0002) != 0  # bit1 = PhyTxBuff_Empty in your iCD mux
            if not tx_ack and tx_empty:
                return True
        time.sleep(0.01)
    print("  ⚠️  Timed out waiting for AutoTx idle")
    return False

